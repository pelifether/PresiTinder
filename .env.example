# Upstash Redis, usado por api/subscribe (e-mails) e api/match (contagem
# de matches). Os dois endpoints são write-only; a leitura é no console
# do Upstash, nunca na web.
# Em produção estas variáveis vêm do store conectado em Vercel → Storage
# (que injeta KV_REST_API_*). Nada aqui deve ser preenchido no repositório.

KV_REST_API_URL=
KV_REST_API_TOKEN=

# Nomes nativos do Upstash, aceitos como alternativa aos de cima.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
